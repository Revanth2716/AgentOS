# AgentOS configuration (all optional — the app runs fully offline with demo defaults)

# Server
AGENTOS_PORT=8787
AGENTOS_HOST=127.0.0.1
AGENTOS_DATA_DIR=.agentos

# Demo mode (default true when no cloud provider configured)
AGENTOS_DEMO_MODE=true

# Ollama (local LLM, optional). Disabled unless AGENTOS_ENABLE_OLLAMA=true
AGENTOS_ENABLE_OLLAMA=false
AGENTOS_OLLAMA_URL=http://127.0.0.1:11434
AGENTOS_OLLAMA_MODEL=llama3.2

# OpenAI-compatible provider (optional; NEVER required)
AGENTOS_OPENAI_BASE_URL=
AGENTOS_OPENAI_API_KEY=
AGENTOS_OPENAI_MODEL=gpt-4o-mini

# Optional price overrides (JSON: {"model": {"in": 0.00015, "out": 0.0006}} per 1K tokens)
AGENTOS_PRICE_OVERRIDES=

# Network guard: extra hosts the http.fetch tool may reach beyond public internet
AGENTOS_FETCH_ALLOW_HOSTS=

# Logging: pretty console logs in dev (structured JSON in prod / CI)
AGENTOS_LOG_PRETTY=false
