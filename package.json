{
  "name": "agentos",
  "version": "0.1.0",
  "private": true,
  "description": "AgentOS — Local-first AI agent control plane: registry, policy governance, workflow orchestration, human approvals, traces, evaluations, and cost accounting.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w apps/server run dev",
    "dev:web": "npm -w apps/web run dev",
    "start": "npm -w apps/server run start",
    "build": "npm -w apps/web run build",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "lint": "node scripts/lint.mjs",
    "cli": "node packages/cli/bin/agentos.mjs",
    "demo": "node packages/cli/bin/agentos.mjs demo",
    "doctor": "node packages/cli/bin/agentos.mjs doctor",
    "setup:browser": "playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  }
}
